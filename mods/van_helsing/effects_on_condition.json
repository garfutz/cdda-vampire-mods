[
  {
    "type": "effect_on_condition",
    "id": "EOC_READ_VAN_HELSING_JOURNAL",
    "effect": [
      {
        "u_message": "You open your field journal.  Decades of meticulous entries fill the parchment:\n\n'VAMPIRE PHYSIOLOGY: The heart must be pierced by mountain ash or consecrated silver.  Decapitation ensures cessation of tissue regeneration.  Sunlight burns due to dimensional destabilization.\n\nSANCTUARY ACCORD: In 1848, the Council of Elders and the Holy Inquisitors signed the Treaty of the Chalice.  Neutral ground was established where hunters and vampires may drink without violence.\n\nLOCATION: The Crimson Chalice operates quietly in the nearby township under Lord Cassian's watchful eye.  If the Cataclysm has severed contact with our orders, that bar remains our best source of intelligence.'",
        "popup": true
      },
      {
        "u_add_morale": "morale_feeling_good",
        "bonus": 20,
        "max_bonus": 40,
        "duration": "6 hours",
        "decay_start": "3 hours"
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_DRINK_CRIMSON_VINTAGE",
    "effect": [
      {
        "if": {
          "or": [
            { "u_has_trait": "VAMPIRE" },
            { "u_has_trait": "VAMPIRE2" },
            { "u_has_trait": "VAMPIRE3" },
            { "u_has_trait": "DHAMPIR_TRAIT" },
            { "u_has_effect": "vampire_virus" }
          ]
        },
        "then": [
          { "math": [ "u_vitamin('human_blood_vitamin') += 550" ] },
          {
            "u_message": "The rich, velvety blood wine glides down your throat.  Your cold veins flush with warmth, and the terrible gnawing thirst subsides completely.",
            "type": "good"
          },
          {
            "u_add_morale": "morale_drank_blood",
            "bonus": 40,
            "max_bonus": 80,
            "duration": "4 hours",
            "decay_start": "2 hours"
          }
        ],
        "else": [
          {
            "u_message": "The thick, metallic vintage coats your tongue with copper and bitter tannins.  It turns your stomach, but you keep it down.",
            "type": "bad"
          },
          { "u_add_morale": "morale_feeling_bad", "bonus": -15, "max_bonus": -30, "duration": "1 hour" }
        ]
      }
    ]
  },
