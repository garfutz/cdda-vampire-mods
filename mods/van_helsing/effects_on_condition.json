    "type": "effect_on_condition",
    "id": "EOC_CHECK_PROTAGONIST_DUPLICATES",
    "eoc_type": "EVENT",
    "required_event": "game_begin",
    "effect": [
      {
        "if": {
          "or": [ { "u_has_trait": "KLAUS_ORIGINAL_VAMPIRE" }, { "compare_string": [ { "u_val": "profession" }, "klaus_mikaelson" ] } ]
        },
        "then": [
          {
            "u_run_npc_eocs": [ { "id": "EOC_DESPAWN_KLAUS_NPC", "effect": [ { "u_die": { "remove_corpse": true, "supress_message": true } } ] } ],
            "unique_ids": [ "crimson_klaus_npc" ]
          },
          {
            "if": { "not": { "u_has_item": "item_crimson_chalice_invitation" } },
            "then": [ { "u_spawn_item": "item_crimson_chalice_invitation", "count": 1 } ]
          }
        ]
      },
      {
        "if": {
          "or": [
            { "u_has_trait": "ELIJAH_ORIGINAL_VAMPIRE" },
            { "compare_string": [ { "u_val": "profession" }, "elijah_mikaelson" ] }
          ]
        },
        "then": [
          {
            "u_run_npc_eocs": [ { "id": "EOC_DESPAWN_ELIJAH_NPC", "effect": [ { "u_die": { "remove_corpse": true, "supress_message": true } } ] } ],
            "unique_ids": [ "crimson_elijah_npc" ]
          },
          {
            "if": { "not": { "u_has_item": "item_crimson_chalice_invitation" } },
            "then": [ { "u_spawn_item": "item_crimson_chalice_invitation", "count": 1 } ]
          }
        ]
      },
      {
        "if": { "and": [ { "u_has_trait": "ELDER_VAMPIRE_REGENERATION" }, { "math": [ "elder_vampire_got_chalice_invite != 1" ] } ] },
        "then": [
