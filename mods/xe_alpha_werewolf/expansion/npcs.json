    "dynamic_line": {
      "compare_string": [ "yes", { "npc_val": "xe_alpha_wren_met" } ],
      "yes": "Alpha.  What do you need?",
      "no": "You smell like the pines.  Like pack.  You're the one from the homestead, aren't you?  He talked about you.  He was waiting for you."
    },
    "speaker_effect": { "effect": [ { "set_string_var": "yes", "target_var": { "npc_val": "xe_alpha_wren_met" } } ] },
    "responses": [
      {
        "text": "Run with me.  The pack isn't finished yet.",
        "condition": { "not": "npc_following" },
        "effect": "follow",
        "topic": "TALK_XE_ALPHA_WREN_JOIN"
      },
      { "text": "Who are you?", "topic": "TALK_XE_ALPHA_WREN_WHO" },
      { "text": "Voss answered to someone.  Who?", "topic": "TALK_XE_ALPHA_WREN_SIRE" },
      { "text": "Let's talk about something else.", "condition": "npc_following", "topic": "TALK_FRIEND" },
      { "text": "Rest.  I'll be back.", "topic": "TALK_DONE" }
