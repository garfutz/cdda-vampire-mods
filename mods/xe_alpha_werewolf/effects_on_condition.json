  {
    "type": "effect_on_condition",
    "id": "EOC_XE_ALPHA_HOWL",
    "effect": [
      { "u_cast_spell": { "id": "xe_alpha_howl_stun" } },
      { "u_add_effect": "xe_alpha_howl_fury", "duration": "5 minutes" },
