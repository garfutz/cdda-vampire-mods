    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_XE_ALPHA_READ_LETTER",
    "effect": [
      {
        "u_message": "The paper is heavy and cream-colored, the ink the brown of dried blood.  It was nailed to the tree above your fire with one of your packmate's claws.\n\n<color_light_red>\"Dog,\n\nI trust you have found what remains of your family.  The young one screamed the longest.  I had wanted all of you, but you always did run ahead of the others; it is what made you their leader, and it is what left them alone when I came.\n\nThe world is ending, and I find I no longer need to hide.  I have taken the old hunting cabin in the pines, the one your people used to meet at under the full moon.  My servants keep it for me.  Come and die with them, or run, as you do best.\n\n- A. Voss\"</color>\n\nAurelio Voss.  The vampire your pack drove out of these woods a decade ago.  You know exactly where that cabin is.",
        "popup": true
      },
      {
        "if": { "or": [ { "u_has_mission": "MISSION_XE_ALPHA_KILL_VOSS" }, { "math": [ "xe_alpha_voss_slain == 1" ] } ] },
        "then": [ { "u_message": "The cabin is already marked on your map.", "type": "info" } ],
        "else": [
          { "assign_mission": "MISSION_XE_ALPHA_KILL_VOSS" },
          { "u_message": "You know where the old cabin is.  You mark it on your map.", "type": "info" }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_XE_ALPHA_HEMOSTATIC_MAINTENANCE",
    "recurrence": "3 seconds",
    "condition": { "u_has_trait": "XE_ALPHA_OF_THE_PEOPLE" },
    "deactivate_condition": { "not": { "u_has_trait": "XE_ALPHA_OF_THE_PEOPLE" } },
    "effect": [
      {
        "if": {
          "or": [
            { "u_has_effect": "effect_silver_burn" },
            { "u_has_worn_with_flag": "SILVER" },
            { "u_has_wielded_with_flag": "SILVER" }
          ]
        },
        "then": [
          {
            "if": { "math": [ "u_alpha_bleed_ticks > 0" ] },
            "then": [
              { "math": [ "u_alpha_bleed_ticks = 0" ] },
              {
                "u_message": "The agonizing burn of silver dissolves your clotting blood and stalls your regeneration!",
                "type": "bad"
              }
            ]
          }
        ],
        "else": [
          {
            "if": { "and": [ { "not": "is_day" }, { "math": [ "moon_phase() == 4" ] } ] },
            "then": [
              { "math": [ "u_hp('head') = min(u_hp_max('head'), u_hp('head') + 8)" ] },
              { "math": [ "u_hp('torso') = min(u_hp_max('torso'), u_hp('torso') + 8)" ] },
              { "math": [ "u_hp('arm_l') = min(u_hp_max('arm_l'), u_hp('arm_l') + 8)" ] },
              { "math": [ "u_hp('arm_r') = min(u_hp_max('arm_r'), u_hp('arm_r') + 8)" ] },
              { "math": [ "u_hp('leg_l') = min(u_hp_max('leg_l'), u_hp('leg_l') + 8)" ] },
              { "math": [ "u_hp('leg_r') = min(u_hp_max('leg_r'), u_hp('leg_r') + 8)" ] }
            ],
            "else": [
              {
                "if": { "not": "is_day" },
                "then": [
                  { "math": [ "u_hp('head') = min(u_hp_max('head'), u_hp('head') + 6)" ] },
                  { "math": [ "u_hp('torso') = min(u_hp_max('torso'), u_hp('torso') + 6)" ] },
                  { "math": [ "u_hp('arm_l') = min(u_hp_max('arm_l'), u_hp('arm_l') + 6)" ] },
                  { "math": [ "u_hp('arm_r') = min(u_hp_max('arm_r'), u_hp('arm_r') + 6)" ] },
                  { "math": [ "u_hp('leg_l') = min(u_hp_max('leg_l'), u_hp('leg_l') + 6)" ] },
                  { "math": [ "u_hp('leg_r') = min(u_hp_max('leg_r'), u_hp('leg_r') + 6)" ] }
                ],
                "else": [
                  { "math": [ "u_hp('head') = min(u_hp_max('head'), u_hp('head') + 4)" ] },
                  { "math": [ "u_hp('torso') = min(u_hp_max('torso'), u_hp('torso') + 4)" ] },
                  { "math": [ "u_hp('arm_l') = min(u_hp_max('arm_l'), u_hp('arm_l') + 4)" ] },
                  { "math": [ "u_hp('arm_r') = min(u_hp_max('arm_r'), u_hp('arm_r') + 4)" ] },
                  { "math": [ "u_hp('leg_l') = min(u_hp_max('leg_l'), u_hp('leg_l') + 4)" ] },
                  { "math": [ "u_hp('leg_r') = min(u_hp_max('leg_r'), u_hp('leg_r') + 4)" ] }
                ]
              }
            ]
          },
          { "math": [ "u_pain() = max(0, u_pain() - 1)" ] },
          { "if": { "math": [ "u_vitamin('blood') < 0" ] }, "then": [ { "math": [ "u_vitamin('blood') += 5" ] } ] },
          {
            "if": { "math": [ "u_vitamin('redcells') < 0" ] },
            "then": [ { "math": [ "u_vitamin('redcells') += 5" ] } ]
          },
          {
            "if": { "u_has_effect": "bleed" },
            "then": [
              {
                "if": { "and": [ { "not": "is_day" }, { "math": [ "moon_phase() == 4" ] } ] },
                "then": [ { "math": [ "u_alpha_bleed_ticks += 3" ] } ],
                "else": [
                  {
                    "if": { "not": "is_day" },
                    "then": [ { "math": [ "u_alpha_bleed_ticks += 2" ] } ],
                    "else": [ { "math": [ "u_alpha_bleed_ticks += 1" ] } ]
                  }
                ]
              },
              {
                "if": { "math": [ "u_alpha_bleed_ticks >= 8" ] },
                "then": [
                  { "u_lose_effect": "bleed", "target_part": "ALL" },
                  { "u_lose_effect": "bleed", "target_part": "head" },
                  { "u_lose_effect": "bleed", "target_part": "torso" },
                  { "u_lose_effect": "bleed", "target_part": "arm_l" },
                  { "u_lose_effect": "bleed", "target_part": "arm_r" },
                  { "u_lose_effect": "bleed", "target_part": "leg_l" },
                  { "u_lose_effect": "bleed", "target_part": "leg_r" },
                  { "math": [ "u_alpha_bleed_ticks = 0" ] },
                  {
                    "u_message": "Your predatory blood clots rapidly into a thick, fibrous seal, halting all arterial hemorrhaging!",
                    "type": "good"
                  }
                ],
                "else": [
                  {
                    "if": { "math": [ "u_alpha_bleed_ticks == 4" ] },
                    "then": [
                      {
                        "u_message": "Your lupine veins constrict and thick hemostatic platelets rapidly stem the heavy blood loss...",
                        "type": "info"
                      }
                    ]
                  }
                ]
              }
            ],
            "else": [ { "math": [ "u_alpha_bleed_ticks = 0" ] } ]
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_XE_ALPHA_ON_HIT_SILVER",
    "eoc_type": "EVENT",
    "required_event": "character_takes_damage",
    "condition": {
      "and": [
        { "u_has_trait": "XE_ALPHA_OF_THE_PEOPLE" },
        "has_beta",
        { "or": [ { "npc_has_wielded_with_flag": "SILVER" }, { "npc_has_worn_with_flag": "SILVER" } ] }
      ]
    },
    "effect": [
      { "u_add_effect": "effect_silver_burn", "duration": "45 seconds" },
      { "math": [ "u_alpha_bleed_ticks = 0" ] },
      { "u_message": "Silver bites into your flesh, searing your wolf blood like liquid fire!", "type": "bad" }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_XE_ALPHA_SCENT_RADAR",
    "effect": [
      { "u_add_effect": "effect_xe_alpha_scent_radar", "duration": "3 minutes" },
      { "u_make_sound": "snuff...", "volume": 10, "type": "movement" },
      {
        "u_message": "You draw the air deep into your lungs.  The scent trails of the living and the bleeding light up across your awareness.",
        "type": "good"
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_XE_ALPHA_THROAT_TEAR",
    "effect": [
      {
        "u_deal_damage": "cut",
        "bodypart": "head",
        "amount": { "math": [ "rng(120, 180) + (n_val('strength') * 3)" ] },
        "arpen": 50,
        "hit_roll": 10000
      },
      {
        "u_deal_damage": "stab",
        "bodypart": "head",
        "amount": { "math": [ "rng(40, 80)" ] },
        "arpen": 30,
        "hit_roll": 10000
      },
      { "u_add_effect": "bleed", "target_part": "head", "intensity": 30, "duration": "10 minutes" },
      { "math": [ "u_pain() += 40" ] },
      { "u_add_effect": "downed", "duration": "4 seconds" },
      { "u_add_effect": "stunned", "duration": "3 seconds" },
      { "u_make_sound": "CHOMP-CRUNCH!", "volume": 45, "type": "combat" },
      {
        "if": {
          "or": [ { "math": [ "u_hp('head') <= 0" ] }, { "math": [ "u_hp('torso') <= 0" ] }, { "math": [ "u_hp('head') <= 50" ] } ]
        },
        "then": [
          "u_die",
          {
            "npc_message": "With a ferocious guttural roar, you lunge and tear out <u_name>'s throat in a fountain of hot arterial blood!",
            "type": "good"
          },
          { "npc_add_effect": "xe_alpha_howl_fury", "duration": "45 seconds" },
          {
            "npc_message": "Tearing the flesh fills your jaws with warm blood, stoking your predatory fury!",
            "type": "good"
          }
        ],
        "else": [
          {
            "npc_message": "You sink your jaws into <u_name>'s throat, ripping flesh and spraying heavy arterial blood across the dirt!",
            "type": "mixed"
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_XE_ALPHA_TOGGLE_IRON_HIDE",
    "effect": [
      {
        "if": { "u_has_effect": "effect_xe_alpha_iron_hide" },
        "then": [
          { "u_lose_effect": "effect_xe_alpha_iron_hide" },
          {
            "u_message": "You relax your tensed tendons and ironbound pelt, resuming your natural agile stance.",
            "type": "info"
          }
        ],
        "else": [
          { "u_add_effect": "effect_xe_alpha_iron_hide", "duration": "24 hours" },
          {
            "u_message": "Your pelt hardens like cured boiled leather and your muscles lock into iron cords!",
            "type": "good"
          }
        ]
      }
    ]
  }
]
