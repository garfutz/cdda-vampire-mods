  {
    "type": "talk_topic",
    "id": "TALK_KLAUS_ELIJAH",
    "dynamic_line": "Family above all, Niklaus.  Always and forever.  What do you need?",
    "responses": [
      { "text": "Come with me.  Always and forever.", "effect": "follow", "topic": "TALK_KLAUS_SIB_JOIN" },
      { "text": "Let's talk about something else.", "topic": "TALK_FRIEND", "condition": "npc_following" },
      { "text": "Rest.  I'll come back for you.", "topic": "TALK_DONE" }
    ]
  },
  {
    "type": "talk_topic",
    "id": "TALK_KLAUS_REBEKAH",
    "dynamic_line": "If you ever put me back in that box, I'll put you in one.  What do you want?",
    "responses": [
      { "text": "Come with me.  Always and forever.", "effect": "follow", "topic": "TALK_KLAUS_SIB_JOIN" },
      { "text": "Let's talk about something else.", "topic": "TALK_FRIEND", "condition": "npc_following" },
      { "text": "Rest.  I'll come back for you.", "topic": "TALK_DONE" }
    ]
  },
  {
    "type": "talk_topic",
    "id": "TALK_KLAUS_KOL",
    "dynamic_line": "The world ended and I missed it?  Typical.  Well, go on then, what's the offer?",
    "responses": [
      {
        "text": "Come with me, Kol.",
        "trial": { "type": "PERSUADE", "difficulty": 6 },
        "success": { "effect": "follow", "topic": "TALK_KLAUS_SIB_JOIN" },
        "failure": { "topic": "TALK_KLAUS_KOL_LEAVES" }
      },
      { "text": "Let's talk about something else.", "topic": "TALK_FRIEND", "condition": "npc_following" },
      { "text": "Rest.  I'll come back for you.", "topic": "TALK_DONE" }
    ]
  },
  {
    "type": "talk_topic",
    "id": "TALK_KLAUS_FINN",
    "dynamic_line": "We are abominations, Niklaus.  But I suppose the world is full of those now.",
    "responses": [
      { "text": "Come with me.  Always and forever.", "effect": "follow", "topic": "TALK_KLAUS_SIB_JOIN" },
      { "text": "Let's talk about something else.", "topic": "TALK_FRIEND", "condition": "npc_following" },
      { "text": "Rest.  I'll come back for you.", "topic": "TALK_DONE" }
    ]
  },
  {
    "type": "talk_topic",
    "id": "TALK_KLAUS_SIB_JOIN",
    "dynamic_line": "Always and forever.",
    "responses": [ { "text": "Good.", "topic": "TALK_DONE" } ]
  },
  {
    "type": "talk_topic",
    "id": "TALK_KLAUS_KOL_LEAVES",
    "dynamic_line": "And spend the apocalypse taking orders from you?  I don't think so, brother.  Don't wait up.",
